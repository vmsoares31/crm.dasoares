# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...) ou anon legada
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor; nunca expor no navegador
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do app, sem barra final (ex.: https://crm.seudominio.com.br). Usada nos links de
# convite e recuperação de senha e nos redirecionamentos de /auth/callback e do middleware.
# Em produção (Docker atrás de proxy) defina sempre: sem ela, os redirecionamentos usam
# x-forwarded-host/x-forwarded-proto e, por último, a origem da requisição (nunca 0.0.0.0).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
